# Connection string for the Neon Serverless PostgreSQL database this API
# persists all task data to. Never commit the real value — see backend/.env
# (gitignored). Format: postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require
DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require

# Shared secret used by Better Auth (frontend/issuer) and this backend's JWT
# verification dependency (get_current_user_id) to sign/verify tokens (HS256).
# MUST be identical to the frontend's BETTER_AUTH_SECRET (Constitution IV).
BETTER_AUTH_SECRET=replace-with-shared-secret
