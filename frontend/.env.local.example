# Base URL of the Backend feature's FastAPI REST API.
# The frontend's lib/api.ts reads this to build every /api/{user_id}/tasks request.
# Defaults to http://localhost:8000 for local development against the Backend feature.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Shared secret used by Better Auth (frontend) and the FastAPI JWT verification
# middleware (backend) to sign/verify session tokens. MUST be identical on both
# sides (Constitution IV). Not yet consumed by this feature — the Database &
# Authentication feature owns issuing real tokens; see lib/api.ts's getAuthToken()
# stub for the current placeholder behavior.
BETTER_AUTH_SECRET=replace-with-shared-secret

# Base URL Better Auth issues callback/redirect links against.
BETTER_AUTH_URL=http://localhost:3000

# Same Neon connection string backend/.env uses — Better Auth's `pg.Pool`
# adapter (lib/auth.ts) connects to the same shared database.
# Use sslmode=verify-full, not `require`/`prefer`/`verify-ca` — node-postgres
# treats those as deprecated aliases for verify-full and emits a runtime
# deprecation warning (they'll gain weaker, standard-libpq semantics in
# pg-connection-string v3 / pg v9). verify-full is the actual behavior these
# aliases already resolve to today, so this is a no-op for connection
# behavior against Neon's publicly-trusted cert — it just silences the
# warning and future-proofs it.
DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<db>?sslmode=verify-full&channel_binding=require
